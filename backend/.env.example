# ---- Core ----
APP_ENV=development                      # development | production
DATABASE_URL=sqlite:///./khojasphere.db  # or postgresql://user:pass@localhost:5432/khojasphere
JWT_SECRET=                              # REQUIRED in production (32+ chars). python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- URLs / CORS (comma separated list allowed) ----
FRONTEND_URL=http://localhost:8443,http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---- Uploads ----
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ---- AI (all optional: the app works with AI_ENABLED=false or with Ollama not running) ----
AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=25
SEMANTIC_SEARCH_ENABLED=true

# ---- Email (optional). Without SMTP, reset emails are written to ./dev_outbox in development ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KhojaSphere <no-reply@khojasphere.local>

# ---- Seed script (never hardcoded). Leave blank to have random passwords generated and printed once ----
ADMIN_EMAIL=admin@khojasphere.example
ADMIN_PASSWORD=
SEED_PASSWORD=

RATE_LIMIT_ENABLED=true
